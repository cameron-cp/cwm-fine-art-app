# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # only for server-side admin tasks; not used in V1

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Browserless (PDF rendering)
BROWSERLESS_API_KEY=

# Shared secret Browserless presents when fetching the tearsheet render route
TEARSHEET_RENDER_SECRET=

# Separate shared secret for the invoice render route (exposes bank/wire details)
INVOICE_RENDER_SECRET=

# Public app URL (used to build absolute URLs for Browserless to hit)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic API key for tearsheet PDF import (Opus 4.7)
ANTHROPIC_API_KEY=

# Resend (transactional email). Sending is skipped when RESEND_API_KEY is unset.
RESEND_API_KEY=
# Verified sender — "CW Fine Art <studio@yourdomain.com>" or a bare address.
EMAIL_FROM=
# Optional default reply-to so collector replies land in a real inbox (her Gmail).
EMAIL_REPLY_TO=
