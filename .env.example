# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # only for server-side admin tasks; not used in V1

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Browserless (PDF rendering)
BROWSERLESS_API_KEY=

# Shared secret Browserless presents when fetching the tearsheet render route
TEARSHEET_RENDER_SECRET=

# Separate shared secret for the invoice render route (exposes bank/wire details)
INVOICE_RENDER_SECRET=

# Public app URL (used to build absolute URLs for Browserless to hit)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic API key for tearsheet PDF import (Opus 4.7)
ANTHROPIC_API_KEY=

# Resend (transactional email). Sending is skipped when RESEND_API_KEY is unset.
RESEND_API_KEY=
# Verified sender — "CW Fine Art <studio@yourdomain.com>" or a bare address.
EMAIL_FROM=
# Optional default reply-to so collector replies land in a real inbox (her Gmail).
EMAIL_REPLY_TO=

# Stripe (invoice pay-by-card/ACH, card-on-file, retainers). Feature stays dark
# until STRIPE_SECRET_KEY is set. No NEXT_PUBLIC_STRIPE_* key — all card/bank
# entry is on Stripe-hosted pages (Checkout + Billing Portal), zero PCI scope.
# Use test keys (sk_test_…) in dev, live keys (sk_live_…) in prod. Secrets are
# managed via Doppler.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…). Local: `stripe listen --forward-to \
# localhost:3000/api/stripe/webhook` prints it. Prod: from the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
# NOTE — two Stripe Dashboard prerequisites the code can't set for you:
#   1. ACH: enable `us_bank_account` + Financial Connections, else only card
#      shows at Checkout (ACH is USD-only regardless).
#   2. Billing Portal: create a Customer Portal configuration, else
#      billingPortal.sessions.create errors in live mode.
